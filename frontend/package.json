{
  "name": "opengym-frontend",
  "private": true,
  "version": "1.4.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:local": "node scripts/build-local.mjs",
    "build:mobile": "VITE_MOBILE=1 vite build && node ../scripts/catalogue/stage-media.mjs dist && cap sync && node scripts/check-mobile-bundle.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:security": "npm audit --audit-level=low && node scripts/check-security-tooling.mjs",
    "test:fatigue-probe": "node scripts/fatigue-monotonic-probe.mjs"
  },
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor-mlkit/barcode-scanning": "^8.2.1",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "jsqr": "^1.4.0",
    "lean-qr": "^2.7.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.1.12",
    "happy-dom": "^21.0.4",
    "linkedom": "^0.18.14",
    "playwright": "1.64.1",
    "vite": "~8.3.5",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@capacitor/assets": {
      "sharp": "0.35.5",
      "@capacitor/cli": "$@capacitor/cli"
    },
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
