{
  "name": "opengym-frontend",
  "private": true,
  "version": "1.4.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:mobile": "VITE_MOBILE=1 vite build && node scripts/check-season-clock.mjs dist && node ../scripts/catalogue/stage-media.mjs dist && cap sync && node scripts/check-mobile-bundle.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:fatigue-probe": "node scripts/fatigue-monotonic-probe.mjs",
    "pdf:check": "node scripts/pdf/render-samples.mjs --out pdf-samples --langs en,de,ar --paper A4,Letter --check",
    "build:local": "node scripts/build-local.mjs",
    "check:security": "npm audit --audit-level=low && node scripts/check-security-tooling.mjs",
    "check:native-localizations": "node scripts/check-native-localizations.mjs"
  },
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor-mlkit/barcode-scanning": "^8.2.2",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.2",
    "jsqr": "^1.4.0",
    "leaflet": "^1.9.4",
    "lean-qr": "^2.7.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^4.1.12",
    "fast-check": "^4.10.2",
    "happy-dom": "^21.0.4",
    "linkedom": "^0.18.15",
    "vite": "~8.3.8",
    "vitest": "^4.1.12",
    "@capacitor/assets": "^3.0.5",
    "playwright": "1.65.1"
  },
  "overrides": {
    "@capacitor/assets": {
      "sharp": "0.35.5",
      "@capacitor/cli": "$@capacitor/cli"
    },
    "xcode": {
      "uuid": "11.1.1"
    },
    "@capacitor/cli": {
      "tar": "7.5.22"
    }
  }
}
